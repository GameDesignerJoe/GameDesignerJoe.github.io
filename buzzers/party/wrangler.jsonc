// Cloudflare Worker + Durable Object that hosts Buzzers rooms (PartyServer).
// Deploy: npx wrangler login (once), then npx wrangler deploy. Free plan is fine.
{
  "name": "buzzers",
  "main": "server.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "BuzzersRoom" },
      { "name": "Budget", "class_name": "BuzzersBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BuzzersRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["BuzzersBudget"] }
  ]
}
