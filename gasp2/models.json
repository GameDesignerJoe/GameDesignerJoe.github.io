        4,
        6,
        8
      ],
      "durFormat": "s",
      "extra": {
        "generate_audio": false,
        "aspect_ratio": "9:16",
        "resolution": "720p"
      },
      "pricePerSecond": 0.1
    },
    "seedance-1-pro": {
      "label": "Seedance 1.0 Pro (720p)",
      "endpoint": "fal-ai/bytedance/seedance/v1/pro/image-to-video",
