{
  "_note": "Video models on fal. image = the field that takes the keyframe URL; durFormat = how fal wants the length (string \"5\", \"5s\", or a number). Prices are USD per second of video, audio off, from fal's model pages (Nov 2026). Add a model by adding an entry; the app lists them all.",
  "video": {
    "kling-2.6-pro": {
      "label": "Kling 2.6 Pro",
      "endpoint": "fal-ai/kling-video/v2.6/pro/image-to-video",
      "image": "start_image_url",
      "durations": [
        5,
        10
      ],
      "durFormat": "string",
      "extra": {
        "generate_audio": false
      },
      "pricePerSecond": 0.07
    },
    "veo-3.1-fast": {
      "label": "Veo 3.1 Fast",
      "endpoint": "fal-ai/veo3.1/fast/image-to-video",
